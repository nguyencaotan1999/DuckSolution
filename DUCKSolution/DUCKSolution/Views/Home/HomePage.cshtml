@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Home";
}
@* Anti-forgery token: read by duckCalculationPage.js and sent as the
   RequestVerificationToken header when POSTing to /Admin/SaveDuckData. *@
@Html.AntiForgeryToken()

<main class="home-page" aria-label="Duck Audit homepage">
    <section class="home-hero py-5 py-lg-6" style="border-radius:40px;margin:10px;padding:10px">
        <div class="container">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-12 col-lg-7">
                    <span class="hero-badge">Duck Audit Platform</span>
                    <h1 class="hero-title mt-3 mb-3">Trang trại vịt</h1>
                    <p class="hero-subtitle mb-4">
                        Hệ thống tính toán và lưu trữ vịt khi xuất chuồng.
                    </p>
                    <a href="#features" class="btn btn-dark btn-lg hero-cta" aria-label="Explore system features">Di chuyển đến tạo đơn hàng</a>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="hero-visual" role="img" aria-label="Illustration representing duck farm operations and analytics">
                        <img class="duck-icon" src="/img/icon/duck.png" alt="Rubber Duck" >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="features" class="features-section py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Data Management feature">
                        <div class="feature-image-box" role="img" aria-label="Data management icon area">
                            <i class="bi bi-database-fill-gear"></i>
                        </div>
                        <h4 class="feature-title">Tạo mã đơn hàng</h4>
                        <input id="orderCodeinput" inputmode="decimal" class="form-control" type="text" maxlength="10" />
                        <div class="row" style="text-align:center; margin-top: 10px;padding:10px">
                            <button id="btncreateOrderCode" class="btn btn-dark learn-more-btn mt-auto" data-card-title="Data Management" aria-label="Learn more about Data Management">
                                Tạo mã đơn hàng
                            </button>
                        </div>
                        
                    </article>
                </div>
                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Duck Farm Audit feature">
                        <div class="feature-image-box" role="img" aria-label="Duck farm audit icon area">
                            <i class="bi bi-clipboard2-check"></i>
                        </div>
                        <h4 class="feature-title">Tính Lồng</h4>
                        <p class="feature-text">
                            Quản lý và tính số lồng
                        </p>
                        <button onclick="window.location.href='/Admin/BoxCalculationPage'" class="btn btn-dark learn-more-btn mt-auto" data-card-title="Duck Farm Audit" aria-label="Learn more about Duck Farm Audit">
                            Bắt đầu....
                        </button>
                    </article>
                </div>

                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Box Calculation feature">
                        <div class="feature-image-box" role="img" aria-label="Box calculation icon area">
                            <i class="bi bi-calculator"></i>
                        </div>
                        <h4 class="feature-title">Tính vịt xuất chuồng</h4>
                        <p class="feature-text">
                            Quản lý và tính số vịt xuất chuồng.
                        </p>
                        <button onclick="window.location.href='/Admin/DuckCalculationPage'" class="btn btn-dark learn-more-btn mt-auto" data-card-title="Box Calculation" aria-label="Learn more about Box Calculation">
                            Bắt đầu....
                        </button>
                    </article>
                </div>

                
            </div>


            <div class="row g-4 mt-3">
                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Data Management feature">
                        <img class="family-picture" src="/img/2ebf63c6cc2c4d72143d1.jpg" alt="Rubber Duck">
                    </article>
                </div>
                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Duck Farm Audit feature">
                        <img class="family-picture" src="/img/6da5fe9a5170d02e8961.jpg" alt="Rubber Duck">
                    </article>
                </div>

                <div class="col-12 col-md-6 col-lg-4 d-flex">
                    <article class="feature-card w-100" aria-label="Box Calculation feature">
                        <img class="family-picture" src="/img/deb1e5ca4a20cb7e92313.jpg" alt="Rubber Duck">
                    </article>
                </div>

                
            </div>
        </div>
    </section>
</main>

<div id="homeToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="true"></div>

<style>
    .home-page {
        background: #f9fafb;
        color: #1f2937;
        overflow-x: hidden;
    }

    .py-lg-6 {
        padding-top: 5rem;
        padding-bottom: 5rem;
    }
    
    .duck-icon {
        display: block;
        width: 25%;
        height: 25%;
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain; /* Giữ tỷ lệ ảnh */
    }
    .family-picture{
     display: block;
        width: 100%;
        height: 100%;
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
    }

    .home-hero {
        background: linear-gradient(135deg, #999999 0%, #CC99FF 100%);
        color: #1a1a1a;
    }

    .hero-badge {
        display: inline-block;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.45rem 0.8rem;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 999px;
    }

    .hero-title {
        font-size: clamp(1.8rem, 3.5vw, 3rem);
        font-weight: 800;
        line-height: 1.15;
    }

    .hero-subtitle {
        max-width: 52ch;
        font-size: clamp(1rem, 1.2vw, 1.15rem);
        opacity: 0.92;
    }

    .hero-cta {
        border-radius: 999px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
    }

    .hero-visual {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 1.25rem;
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.15);
    }

    .hero-visual i {
        font-size: clamp(3rem, 8vw, 5rem);
        color: #d09300;
    }

    .features-section {
        background: #ffffff;
    }

    .section-title {
        font-size: clamp(1.5rem, 2.8vw, 2.2rem);
        font-weight: 800;
        color: #111827;
    }

    .section-subtitle {
        color: #4b5563;
        max-width: 68ch;
        margin-inline: auto;
    }

    .feature-card {
        background: linear-gradient(135deg, #999999 0%, #CC99FF 100%);
        border-radius: 1rem;
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        min-height: 100%;
    }

    .feature-card:hover,
    .feature-card:focus-within {
        transform: translateY(-8px);
        box-shadow: 0 18px 34px #d09300;
    }

    .feature-image-box {
        background: #ffffff;
        border-radius: 0.85rem;
        min-height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .feature-image-box i {
        font-size: clamp(2.6rem, 7vw, 4rem);
        color: #d09300;
    }

    .feature-title {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        color: #444444;
        margin-bottom: 0.7rem;
        text-transform: uppercase;
    }

    .feature-text {
        color: #444444;
        line-height: 1.55;
        margin-bottom: 1rem;
        flex-grow: 1;
    }

    .learn-more-btn {
        align-self: flex-start;
        border-radius: 999px;
        font-weight: 600;
        padding-inline: 1rem;
    }

    @@media (max-width: 991.98px) {
        .hero-subtitle {
            max-width: 100%;
        }

        .feature-image-box {
            min-height: 150px;
        }
    }

    @@media (max-width: 575.98px) {
        .home-hero,
        .features-section {
            padding-left: 0.35rem;
            padding-right: 0.35rem;
        }

        .feature-card {
            padding: 1rem;
        }
    }
</style>

@section Scripts {
    <script src="~/js/homePage.js" asp-append-version="true"></script>
}